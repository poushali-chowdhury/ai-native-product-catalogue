PORT=3001

# Browser origin allowed to call this API.
FRONTEND_ORIGIN=http://localhost:5173

# Used only on the server. Product responses never include this address.
FAKE_STORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=8000

# Local Mailpit. Leave SMTP_USER and SMTP_PASS empty when Mailpit has no login.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=catalogue@localhost
SALES_EMAIL=sales@localhost
